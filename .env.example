# Relay settings, read from the environment: `set -a; . ./.env; set +a` before `cargo run`.
PORT=8758
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=buccanet
# Public origin of the web app, used to build invite links
PUBLIC_ORIGIN=http://localhost:8759
# Days a sealed message waits in the relay before deletion
MESSAGE_TTL_DAYS=30
